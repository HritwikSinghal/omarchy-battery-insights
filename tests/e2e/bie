#!/usr/bin/env bash
# bie -- a hidden, isolated Omarchy desktop for testing this plugin end to end.
# Adapted from the e2e harness of the maintainer's omarchy-notification-center fork.
#
#   bie up            start it (blocks until `bie down`; run it in the background)
#   bie wait          wait until the plugin inside answers
#   bie run CMD...    run a command inside: wtype, omarchy-shell, hyprctl, ...
#   bie state         the panel's state as JSON (omarchy-shell omarchy.power state)
#   bie home          print the session's HOME (fixture state lives under it)
#   bie shot FILE     screenshot the test screen (E2E) to FILE
#   bie down          stop it
#
# Isolation: the session gets its own XDG_RUNTIME_DIR (so its Wayland, Hyprland
# and shell sockets are its own), its own D-Bus session bus (so notifications
# go to the Omarchy daemon inside, never to the real one), and its own HOME
# (fixture config; the plugin is this repository's working tree, linked in).
# Nothing it runs can reach the real desktop's compositor, shell or files.
# UPower and power-profiles-daemon are on the SYSTEM bus, which is shared:
# reading them is fine, but never press Enter on a power profile in a test.
#
# BIE_SEED=DIR copies DIR's files into the session's battery-insights state
# directory before the shell starts (samples.csv, ui.json, stock-ack, ...).
# BATTERY_INSIGHTS_STOCK_DIR, when set, reaches the plugin's service as is.
# BIE_OUTPUTS=2 starts the session with two screens (two bars, two widgets).
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
HERE=$REPO/tests/e2e
# Sockets live under the session dir, and a socket path may not exceed 108
# bytes, so the session dir sits directly in TMPDIR with a short name.
BASE=${TMPDIR:-/tmp}
CURRENT=$BASE/bie-current   # symlink to the live session's directory
PLUGIN_ID=hritwiksinghal.battery-insights

die() { echo "bie: $*" >&2; exit 1; }

session() {
  [[ -d $CURRENT && -f $CURRENT/env ]] || die "no session; start one with: bie up"
  echo "$CURRENT"
}

in_session() {
  local dir; dir=$(session)
  # shellcheck disable=SC1091
  ( source "$dir/env" && exec "$@" )
}

make_home() {
  local home=$1
  mkdir -p "$home/.config/omarchy/plugins" "$home/.local/state/omarchy/notifications" "$home/.cache"
  cp "$HERE/fixtures/shell.json" "$home/.config/omarchy/shell.json"
  ln -s "$REPO" "$home/.config/omarchy/plugins/$PLUGIN_ID"
  # Without a seed there is no state directory at all: a first run.
  if [[ -n ${BIE_SEED:-} ]]; then
    mkdir -p "$home/.local/state/battery-insights"
    cp -a "$BIE_SEED/." "$home/.local/state/battery-insights/"
  fi
  # The theme only decides colours; borrow the real one when there is one.
  local theme=${REAL_HOME:-$HOME}/.local/state/omarchy/current
  [[ -e $theme ]] && ln -s "$theme" "$home/.local/state/omarchy/current"
  local fonts=${REAL_HOME:-$HOME}/.local/share/fonts
  if [[ -d $fonts ]]; then mkdir -p "$home/.local/share"; ln -s "$fonts" "$home/.local/share/fonts"; fi
}

host_display() {
  local display=${WAYLAND_DISPLAY:-}
  [[ -n $display ]] || die "needs a running Wayland session (WAYLAND_DISPLAY is empty)"
  [[ $display == /* ]] || display=${XDG_RUNTIME_DIR:-/run/user/$UID}/$display
  [[ -S $display ]] || die "no Wayland socket at $display"
  echo "$display"
}

cmd_up() {
  [[ ! -e $CURRENT/ready ]] || die "a session is already up at $(readlink -f "$CURRENT"); bie down first"
  [[ -n ${OMARCHY_PATH:-} && -d $OMARCHY_PATH/shell ]] || die "OMARCHY_PATH must point at an Omarchy install (it has no shell/)"
  local host dir
  host=$(host_display)
  dir=$(mktemp -d "$BASE/bie.XXXX")
  mkdir -m 700 "$dir/r"
  REAL_HOME=$HOME make_home "$dir/h"
  ln -sfn "$dir" "$CURRENT"
  echo "bie: session in $dir"
  exec dbus-run-session -- "$0" _inside "$dir" "$host"
}

ready_probe() {
  omarchy-shell omarchy.power state 2> /dev/null | grep -q '"opened"'
}

# Runs inside dbus-run-session: everything below shares the private bus and
# ends with the nested Hyprland.
cmd_inside() {
  local dir=$1 host=$2
  export XDG_RUNTIME_DIR=$dir/r HOME=$dir/h
  unset HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY DISPLAY \
        XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_DATA_HOME

  WAYLAND_DISPLAY=$host Hyprland -c "$HERE/hyprland.lua" > "$dir/hyprland.log" 2>&1 &
  local hypr=$!
  local i
  for i in $(seq 1 100); do
    compgen -G "$dir/r/hypr/*/.socket.sock" > /dev/null && break
    sleep 0.1
  done
  compgen -G "$dir/r/hypr/*/.socket.sock" > /dev/null || die "nested Hyprland did not start (see $dir/hyprland.log)"
  HYPRLAND_INSTANCE_SIGNATURE=$(basename "$(dirname "$(compgen -G "$dir/r/hypr/*/.socket.sock" | head -n1)")")
  WAYLAND_DISPLAY=$(cd "$dir/r" && compgen -G 'wayland-[0-9]*' | grep -v '\.lock$' | head -n1)
  export HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY

  {
    local var
    for var in XDG_RUNTIME_DIR HOME HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS OMARCHY_PATH PATH; do
      printf 'export %s=%q\n' "$var" "${!var-}"
    done
  } > "$dir/env"

  # A fixed-size headless screen for the panel and the screenshots; the
  # nested window on the real desktop is switched off.
  hyprctl output create headless E2E > /dev/null
  # BIE_OUTPUTS=2: a second screen from the start, so the shell builds two
  # bars and two copies of the widget.
  if ((${BIE_OUTPUTS:-1} >= 2)); then hyprctl output create headless E2E-2 > /dev/null; fi
  sleep 0.3
  # With the nested window's output off, E2E is the only screen and so has focus.
  hyprctl eval 'hl.monitor({ output = "WAYLAND-1", disabled = true })' > /dev/null

  # Its own process group, so the shell and everything it starts can be
  # stopped together when the session ends: Quickshell does not stop its
  # children (inotifywait on the plugins directory), and they would otherwise
  # outlive the session, reparented to the user's systemd.
  setsid qs -p "$OMARCHY_PATH/shell" > "$dir/shell.log" 2>&1 &
  local qs=$!
  local ok=0
  for i in $(seq 1 150); do
    ready_probe && break
    sleep 0.2
  done
  if ready_probe; then
    touch "$dir/ready"
    echo "bie: ready"
    ok=1
  else
    # Nothing will run `bie down` for a session that never got ready, so end
    # it here; the session directory is kept for its logs.
    echo "bie: the plugin did not answer; see $dir/shell.log" >&2
    hyprctl dispatch 'hl.dsp.exit()' > /dev/null 2>&1 || kill "$hypr" 2> /dev/null || true
  fi
  wait "$hypr" || true
  rm -f "$dir/ready"
  # setsid made qs the leader of its own process group. The group outlives
  # its leader, so this reaches the orphaned watchers even when qs itself has
  # already exited with the compositor. (No `ps` probe here: under set -e a
  # failed probe of an exited qs would end the script before the cleanup.)
  kill -TERM -- "-$qs" 2> /dev/null || true
  if ((ok)); then
    [[ $(readlink "$CURRENT" 2> /dev/null) == "$dir" ]] && rm -f "$CURRENT"
    [[ $dir == "$BASE"/bie.* ]] && rm -rf -- "$dir"
  fi
  echo "bie: session ended"
}

cmd_wait() {
  local i
  for i in $(seq 1 ${1:-60}); do
    [[ -e $CURRENT/ready ]] && return 0
    sleep 1
  done
  die "session not ready after ${1:-60}s"
}

cmd_shot() {
  [[ $# -eq 1 ]] || die "usage: bie shot FILE"
  in_session grim -o E2E "$1"
}

case ${1:-} in
  up) shift; cmd_up "$@" ;;
  _inside) shift; cmd_inside "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  run) shift; in_session "$@" ;;
  state) in_session omarchy-shell omarchy.power state ;;
  home) echo "$(session)/h" ;;
  shot) shift; cmd_shot "$@" ;;
  # Hyprland's Lua config mode takes Lua dispatchers: `dispatch exit` is an error.
  down) in_session hyprctl dispatch 'hl.dsp.exit()' > /dev/null ;;
  *) sed -n '2,12p' "$0"; exit 2 ;;
esac
